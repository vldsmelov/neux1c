# DJANGO_DEBUG=1 включает dev-режим. Все production-guard'ы в settings.py
# срабатывают только при DJANGO_DEBUG=0 (см. ниже).
DJANGO_DEBUG=1

# При DJANGO_DEBUG=0 settings.py отвергнет старт, если:
#  - SECRET_KEY короче 50 символов или содержит "dev-only-secret-key",
#    "django-insecure-", "change-me";
#  - ALLOWED_HOSTS пустой или содержит "*".
# Для prod сгенерируйте сильный ключ: python -c 'import secrets;print(secrets.token_urlsafe(64))'
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0

POSTGRES_DB=ne_ux
POSTGRES_USER=ne_ux
POSTGRES_PASSWORD=ne_ux
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Демо-пароль для setup_access_roles --with-users. При DJANGO_DEBUG=0 команда
# откажется создавать пользователей с дефолтным "demo12345" — задайте свой пароль
# или передайте --allow-weak-password явно.
NE_UX_DEMO_PASSWORD=demo12345
NE_UX_MAX_JUSTIFICATION_FILE_SIZE=5242880
NE_UX_ALLOWED_JUSTIFICATION_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg
NE_UX_ALLOWED_JUSTIFICATION_CONTENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/png,image/jpeg

# Опциональный AV-сканер для файлов обоснования. Dotted-path к функции,
# принимающей UploadedFile и поднимающей ValidationError при обнаружении угрозы.
# Пример: NE_UX_AV_SCANNER=myproject.security.clamd_scan
# Если переменная не задана — скан отключён (pilot-mode).
NE_UX_AV_SCANNER=
